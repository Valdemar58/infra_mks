# Корневой CA: используется только certs/setup.sh при создании корня.
# Смена CN или O здесь ничего не меняет у уже выпущенного корня.
# Расширения серверного сертификата генерируются скриптом в leaf_ext.cnf
# из имен HOST_* корневого .env.
[ req ]
distinguished_name = dn_ca
x509_extensions    = v3_ca
prompt             = no

[ dn_ca ]
CN = MKS Internal Root CA
O  = infra_mks

[ v3_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical,CA:true
keyUsage               = critical,keyCertSign,cRLSign
