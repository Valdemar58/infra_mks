    {
      "id": 43,
      "type": "timeseries",
      "title": "Входы",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (etype) (count_over_time({service=\"keycloak\"} |= \"org.keycloak.events\" | json loggerName, message | loggerName=\"org.keycloak.events\" | line_format \"{{.message}}\" | regexp `type=\"(?P<etype>[A-Z_]+)\"` | etype=~\"LOGIN|LOGIN_ERROR\" [$__auto]))",
          "legendFormat": "{{etype}}",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0,
            "insertNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LOGIN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LOGIN_ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m"
    },
    {
      "id": 44,
      "type": "bargauge",
      "title": "Причины неудачных входов",
      "description": "invalid_user_credentials это неверный пароль, user_not_found это неизвестный логин",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (reason) (count_over_time({service=\"keycloak\"} |= \"org.keycloak.events\" | json loggerName, message | loggerName=\"org.keycloak.events\" | line_format \"{{.message}}\" | regexp `type=\"(?P<etype>[A-Z_]+)\"` | etype=\"LOGIN_ERROR\" | regexp `error=\"(?P<reason>[^\"]*)\"` [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "displayName": "${__data.fields.reason}"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "manual",
        "minVizHeight": 36,
        "maxVizHeight": 36,
        "text": {
          "titleSize": 13,
          "valueSize": 14
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 45,
      "type": "table",
      "title": "Неудачные входы по пользователям",
      "description": "",
      "gridPos": {
        "x": 0,
