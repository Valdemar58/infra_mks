  "panels": [
    {
      "id": 61,
      "type": "stat",
      "title": "Запросов маршрутизации",
      "description": "Запросы к Valhalla обоих сезонов без проверок живости",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"valhalla\"} |~ \" (GET|POST) /\" | regexp `^\\d+ \\S+ \\S+ (?P<method>GET|POST) (?P<action>/[a-z_]+)` | action!=\"\" | action!=\"/status\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 62,
      "type": "stat",
      "title": "Ошибки маршрутизации",
      "description": "Доля запросов с ошибкой, чаще всего точка далеко от дорог",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({service=\"valhalla\", level=~\"warning|error\"} | regexp `(?P<reason>\\d{3}::[^\\x1b]*?)( request_id=\\d+)?$` | reason!=\"\" [$__range])) or vector(0)) / sum(count_over_time({service=\"valhalla\"} |~ \" (GET|POST) /\" | regexp `^\\d+ \\S+ \\S+ (?P<method>GET|POST) (?P<action>/[a-z_]+)` | action!=\"\" | action!=\"/status\" [$__range])) * 100",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 63,
      "type": "stat",
      "title": "Тайлы из кэша",
      "description": "Доля тайлов, отданных nginx без рендера",
