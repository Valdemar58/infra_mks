          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({service=\"nginx\"} |= \"vhost\" | json vhost, status, request_time, uri, remote_addr, cache, method | vhost=~\".*tiles.*\" | uri=~\"/styles/.*\" | cache=\"HIT\" [$__range])) or vector(0)) / sum(count_over_time({service=\"nginx\"} |= \"vhost\" | json vhost, status, request_time, uri, remote_addr, cache, method | vhost=~\".*tiles.*\" | uri=~\"/styles/.*\" [$__range])) * 100",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
