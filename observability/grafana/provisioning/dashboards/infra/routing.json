    {
      "id": 65,
      "type": "timeseries",
      "title": "Запросы Valhalla по типу",
      "description": "route это маршрут, sources_to_targets это матрица расстояний",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (action) (count_over_time({service=\"valhalla\"} |~ \" (GET|POST) /\" | regexp `^\\d+ \\S+ \\S+ (?P<method>GET|POST) (?P<action>/[a-z_]+)` | action!=\"\" | action!=\"/status\" [$__auto]))",
          "legendFormat": "{{action}}",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0,
            "insertNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m"
    },
