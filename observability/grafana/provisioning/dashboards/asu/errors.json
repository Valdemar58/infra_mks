      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"asu_api|asu_ui\", level=~\"error|critical\"} | json event, path, method, username, repo, exception | line_format \"{{.event}}  {{.method}} {{.path}}  {{ if .username }}{{.username}}{{ else }}{{.repo}}{{ end }}{{ if .exception }}\\n{{ .exception }}{{ end }}\"",
          "legendFormat": "",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    },
    {
      "id": 25,
      "type": "row",
      "title": "База данных",
      "collapsed": false,
