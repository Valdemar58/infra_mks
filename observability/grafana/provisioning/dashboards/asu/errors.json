    {
      "id": 28,
      "type": "table",
      "title": "Самые медленные вызовы БД",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (repo, func) (count_over_time({service=\"asu_api\", level=\"warning\"} |= \"_finished\" | json event, repo, duration_ms | event=~\".+_finished\" | label_format func=`{{ regexReplaceAll \"_finished$\" .event \"\" }}` [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"asu_api\", level=\"warning\"} |= \"_finished\" | json event, repo, duration_ms | event=~\".+_finished\" | label_format func=`{{ regexReplaceAll \"_finished$\" .event \"\" }}` | unwrap duration_ms | __error__=\"\" [$__range]) by (repo, func)",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({service=\"asu_api\", level=\"warning\"} |= \"_finished\" | json event, repo, duration_ms | event=~\".+_finished\" | label_format func=`{{ regexReplaceAll \"_finished$\" .event \"\" }}` | unwrap duration_ms | __error__=\"\" [$__range]) by (repo, func)",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Медленных вызовов"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "fieldMinMax",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Максимум"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "repo": "Репозиторий",
              "func": "Метод",
              "Value #A": "Медленных вызовов",
              "Value #B": "p95",
              "Value #C": "Максимум"
            },
            "indexByName": {
              "repo": 0,
              "func": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Медленных вызовов",
                "desc": true
              }
            ]
          }
        }
      ]
    }
  ]
}
