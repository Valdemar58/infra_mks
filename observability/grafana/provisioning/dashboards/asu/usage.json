    {
      "id": 13,
      "type": "timeseries",
      "title": "Активные пользователи",
      "description": "Уникальные пользователи за каждый час",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (username) (count_over_time({service=\"asu_ui\"} |= \"page_view\" | json event, username, page_title | event=\"page_view\" | username=~\"(?i).*${username}.*\" [$__interval])))",
          "legendFormat": "Интерфейс",
          "queryType": "range",
          "instant": false,
          "range": true,
          "interval": "1h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (username) (count_over_time({service=\"asu_api\"} |= \"request_completed\" | json event, status_code, duration_ms, endpoint, username | event=\"request_completed\" | username=~\"(?i).*${username}.*\" | username!=\"\" [$__interval])))",
          "legendFormat": "API",
          "queryType": "range",
          "instant": false,
          "range": true,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": 0,
            "insertNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Интерфейс"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "API"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Нагрузка по часам суток",
      "description": "Просмотры страниц по часу московского времени за весь период",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (hour) (count_over_time({service=\"asu_ui\"} |= \"page_view\" | json event, username, page_title | event=\"page_view\" | username=~\"(?i).*${username}.*\" | label_format hour=`{{ printf \"%02d\" (mod (add (div (unixEpoch __timestamp__) 3600) 3) 24) }}` [$__range]))",
          "legendFormat": "{{hour}}",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "hour",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "stacking": "none",
        "fullHighlight": false
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "hour": "Час",
              "Value": "Просмотры"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Час",
                "desc": false
              }
            ]
          }
        }
      ]
    },
