// Собирает stdout/stderr контейнеров этого хоста через Docker API и
// отправляет в Loki. Общая docker-сеть с приложением не нужна:
// discovery.docker и loki.source.docker читают смонтированный
// /var/run/docker.sock.
//
// Какие контейнеры брать, задает APP_CONTAINER_REGEX (корневой .env):
// на хосте могут быть посторонние контейнеры. Имя контейнера у Docker
// начинается с "/". Метка app постоянная, дашборды Grafana фильтруют по
// ней и не зависят от имен контейнеров.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(" + sys.env("APP_CONTAINER_REGEX") + ")"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(" + sys.env("APP_CONTAINER_REGEX") + ")"
		action        = "keep"
	}

	rule {
		target_label = "app"
		replacement  = "asu"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = sys.env("LOKI_URL") + "/loki/api/v1/push"
	}
}
