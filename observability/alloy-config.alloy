// Собирает stdout/stderr Docker-контейнеров этого хоста через Docker API
// (discovery.docker) и отправляет в Loki. Не требует общей docker-сети с
// приложением - discovery.docker и loki.source.docker обращаются к Docker
// напрямую через смонтированный /var/run/docker.sock, а не по сети.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Ограничиваем сбор только контейнерами этого приложения (asu_toir_*,
// asu_toir, asu_toir_dev, asu_toir_ci, ...) - на хосте могут быть и другие,
// не относящиеся к проекту контейнеры, которые собирать не нужно.
// container_name у Docker всегда начинается с "/".
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(asu_toir.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/asu_toir.*"
		action        = "keep"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
