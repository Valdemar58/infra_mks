# ----- Корневые настройки инфраструктуры -----
# Читают: setup.sh всех стеков, compose.sh, certs/setup.sh, nginx (шаблоны),
# observability (Alloy). У каждого стека есть и свой .env с его настройками.
# Значения со спецсимволами (| *) держать в двойных кавычках.

# Сеть app-network, через которую nginx и сервисы видят друг друга.
#   bridge   все стеки и приложение на одном хосте
#   overlay  разные серверы в одном docker swarm (см. README, раздел "Сеть")
NETWORK_DRIVER=bridge

# IP сервера с nginx: попадает в SAN сертификата и в записи DNS/hosts.
SERVER_IP=<ip>

# IP для записей hosts на этой машине (hosts.sh). Пусто: SERVER_IP.
# На машине, где nginx запущен локально (dev), 127.0.0.1.
HOSTS_IP=

# Имена сервисов за nginx (TLS 443). Каждое имя: запись DNS или hosts у
# клиентов, шаблон nginx/templates/<сервис>.conf.template, SAN сертификата
# (certs/setup.sh перевыпускает серверный сертификат сам, корень не меняется).
HOST_UI=appsrvs
HOST_AUTH=appsrvs.auth
HOST_REGISTRY=appsrvs.registry
HOST_API=appsrvs.api
HOST_GRAFANA=appsrvs.grafana
HOST_ROUTE=appsrvs.route

# Приложение: имена контейнеров или алиасы в app-network, куда nginx
# проксирует UI и API. При переименовании приложения менять здесь и в
# valhalla/.env (ASU_API_URL).
APP_UI_UPSTREAM=asu_toir
APP_API_UPSTREAM=asu_toir_api

# Какие контейнеры Alloy отправляет в Loki (регулярное выражение по имени).
APP_CONTAINER_REGEX="asu_toir.*|infra_valhalla.*"

# Куда Alloy пишет логи. С других хостов Loki виден по app-network как loki.
LOKI_URL=http://loki:3100

# Сроки сертификатов в днях: корневой CA и серверный сертификат.
# 825 дней для серверного: предел, который принимают строгие клиенты.
CERT_CA_DAYS=3650
CERT_LEAF_DAYS=825

# Префикс зеркала образов для прода без доступа к GitHub (ghcr.io).
# Пусто: образы берутся из исходных registry. Заполнено, например
# appsrvs.registry/mirror/: все образы берутся оттуда (offline/mirror.sh).
IMAGE_MIRROR=

# 1: ничего не скачивать и не собирать, все образы уже загружены
# (offline/bundle.sh на машине с интернетом, offline/load.sh на сервере).
OFFLINE=0
