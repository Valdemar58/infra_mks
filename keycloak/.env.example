# ----- Keycloak, прод (docker-compose.yml) -----
# Dev-режим (docker-compose.dev.yml, ./setup.sh --dev) этот файл не читает:
# там свой dockerized postgres и фиксированные dev-значения.

# Внешний Postgres: БД и пользователь keycloak создаются заранее вручную.
KC_DB_URL=jdbc:postgresql://<host>:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# По умолчанию берется HOST_AUTH из корневого .env
#KC_HOSTNAME=appsrvs.auth

# Параметры LDAP (адрес контроллера, base DN, учетная запись и пароль) и
# секрет клиента streamlit в realm-export.json не хранятся: импорт
# выполняется один раз на пустую БД, реальные значения ставятся через
# kcadm.sh после импорта, команды печатает ./setup.sh.
