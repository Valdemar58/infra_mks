# Порт tileserver на хосте, только для проверок с самого сервера. Снаружи
# подложка доступна через nginx на HOST_TILES из корневого .env.
TILES_PORT=8081

# Откуда берется выгрузка OSM для сборки подложки. По умолчанию карта Valhalla:
# она уже скачана и покрывает те же регионы.
TILES_PBF_DIR=../valhalla/custom_files/summer
TILES_PBF_NAME=base_map.osm.pbf

# Память Java при сборке, примерно половина размера выгрузки.
TILES_BUILD_XMX=2g

# Предельный масштаб векторных тайлов. Глубже tileserver растягивает z14, этого
# достаточно: на больших масштабах подписи и линии остаются читаемыми.
TILES_MAXZOOM=14

# Границы сборки. Пусто: берутся из заголовка выгрузки, это нужный вариант.
# Значение world нарисует весь мир до TILES_MAXZOOM и раздует архив в разы.
TILES_BOUNDS=
