# Откуда берутся исходники сборки подложки. Файл читают build_countries.sh и
# check_sources.sh, первые три адреса planetiler качает сам.
#
# Точку зрения на спорные территории задает суффикс в имени набора стран:
# rus это российская де-юре, рядом лежат ukr, chn и другие.

PLANETILER_URLS="
https://osmdata.openstreetmap.de/download/water-polygons-split-3857.zip
https://dev.maptiler.download/geodata/omt/natural_earth_vector.sqlite.zip
https://dev.maptiler.download/geodata/omt/lake_centerline.shp.zip
"

