# ----- Базовая карта -----

# PBF-выгрузки Geofabrik через пробел. Скачиваются и сливаются в один
# base_map.osm.pbf скриптом prepare_pbf.sh (напрямую контейнеру несколько
# PBF не передаются, сборка из нескольких файлов падает). 7 федеральных
# округов (~3.5 ГБ) покрывают все реальные координаты pool_point и ЛПУ в
# БД: СЗФО/ЦФО/ПФО/УрФО плюс ЮФО/СКФО (Ставрополь, Волгоград, Астрахань)
# и СФО (Томск, Кузбасс, Иркутск). Без покрытия остается только Дальний
# Восток, где точек перекачки нет. Вся Россия целиком (~4 ГБ):
# https://download.geofabrik.de/russia-latest.osm.pbf
TILE_URLS=https://download.geofabrik.de/russia/northwestern-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/volga-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/ural-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/south-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/north-caucasus-fed-district-latest.osm.pbf https://download.geofabrik.de/russia/siberian-fed-district-latest.osm.pbf


# ----- Сервисы Valhalla -----

# Порты на хосте, только 127.0.0.1. Приложение ходит не сюда, а по
# сетевым алиасам valhalla-summer и valhalla-winter в app-network.
VALHALLA_SUMMER_PORT=8002
VALHALLA_WINTER_PORT=8003

# Потоки HTTP-сервера Valhalla. При ребилде тайлов из живого контейнера
# (FORCE_REBUILD=True) задает и потоки сборки: больше потоков быстрее,
# но выше пиковая память сборки. При OOM снизить до 4.
SERVER_THREADS=8

# True только для разового ребилда тайлов (обновление базовой карты,
# см. README.md), после сборки вернуть False
FORCE_REBUILD=False


# ----- Publisher -----

# Адрес API АСУ. Из app-network - имя контейнера приложения.
ASU_API_URL=http://asu_toir_api:8000

# M2M токен АСУ с ролью, имеющей права custom_roads view и edit.
# Выпуск токена описан в README приложения, раздел про api_token.
ASU_API_TOKEN=

# Каталог custom_files по пути НА ХОСТЕ. Publisher поднимает сборку
# тайлов на docker-демоне хоста, поэтому путь тома должен быть хостовым.
# Расхождение с фактическим каталогом ловится проверкой перед сборкой.
HOST_FILES_DIR=/opt/valhalla/custom_files

# Потоки сборки тайлов. При OOM снизить до 4.
BUILD_THREADS=8

# Максимальное расстояние привязки конца кастомной дороги к узлу OSM.
SNAP_TOLERANCE_M=100

# Интервал опроса заявок на публикацию, секунды.
POLL_INTERVAL_S=30
