# Кэш отрендеренных тайлов подложки. Своего дискового кэша у tileserver-gl нет,
# без этой зоны каждый тайл рисуется заново на каждый запрос. Каталог лежит на
# именованном томе, потому что nginx/setup.sh всегда пересоздает контейнер.
# use_temp_path=off обязателен: иначе ответы пишутся во временный каталог на
# слое образа и копируются на том вместо переименования.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:20m
                 max_size=10g inactive=90d use_temp_path=off;
